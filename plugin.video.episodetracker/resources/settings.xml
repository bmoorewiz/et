<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings>
	<category label="32010"><!-- Accounts -->
		<setting label="32011" type="lsep" /><!-- Trakt.tv -->
		<setting id="trakt.client_id" type="text" label="32018" default="" /><!-- Trakt app Client ID -->
		<setting id="trakt.client_secret" type="text" label="32019" default="" option="hidden" /><!-- Trakt app Client Secret -->
		<setting id="trakt.user" type="text" label="32012" default="" enable="false" />
		<setting id="trakt.token" type="text" label="32013" default="" visible="false" />
		<setting id="trakt.refresh" type="text" label="32014" default="" visible="false" />
		<setting id="trakt.expires" type="text" label="32015" default="" visible="false" />
		<setting type="action" label="32016" action="RunPlugin(plugin://plugin.video.episodetracker/?action=trakt_auth)" option="close" /><!-- Authorize Trakt -->
		<setting type="action" label="32017" action="RunPlugin(plugin://plugin.video.episodetracker/?action=trakt_revoke)" option="close" /><!-- Sign out of Trakt -->

		<setting label="32020" type="lsep" /><!-- Real-Debrid -->
		<setting id="rd.user" type="text" label="32021" default="" enable="false" />
		<setting id="rd.client_id" type="text" label="32022" default="" visible="false" />
		<setting id="rd.client_secret" type="text" label="32023" default="" visible="false" />
		<setting id="rd.token" type="text" label="32024" default="" visible="false" />
		<setting id="rd.refresh" type="text" label="32025" default="" visible="false" />
		<setting id="rd.expires" type="text" label="32026" default="" visible="false" />
		<setting type="action" label="32027" action="RunPlugin(plugin://plugin.video.episodetracker/?action=rd_auth)" option="close" /><!-- Authorize Real-Debrid -->
		<setting type="action" label="32028" action="RunPlugin(plugin://plugin.video.episodetracker/?action=rd_revoke)" option="close" /><!-- Sign out of Real-Debrid -->

		<setting label="32090" type="lsep" /><!-- TorBox -->
		<setting id="torbox.enabled" type="bool" label="32091" default="false" />
		<setting id="torbox.api_key" type="text" label="32092" default="" option="hidden" subsetting="true" enable="eq(-1,true)" />
		<setting id="torbox.cached_only" type="bool" label="32093" default="true" subsetting="true" enable="eq(-2,true)" />
		<setting id="torbox.keep_cloud" type="bool" label="32094" default="false" subsetting="true" enable="eq(-3,true)" />
		<setting type="action" label="32095" action="RunPlugin(plugin://plugin.video.episodetracker/?action=torbox_check)" option="close" />
		<setting type="action" label="32096" action="RunPlugin(plugin://plugin.video.episodetracker/?action=torbox_revoke)" option="close" />

		<setting label="32097" type="lsep" /><!-- Provider order -->
		<setting id="debrid.priority" type="enum" label="32098" values="Real-Debrid first|TorBox first" default="0" />
	</category>

	<category label="32040"><!-- Playback -->
		<setting id="results.autoplay" type="bool" label="32041" default="false" /><!-- Auto-play best source -->
		<setting id="results.limit" type="slider" label="32042" default="150" range="25,25,500" option="int" /><!-- Max sources to show -->
		<setting id="quality.4k" type="bool" label="32043" default="true" />
		<setting id="quality.1080p" type="bool" label="32044" default="true" />
		<setting id="quality.720p" type="bool" label="32045" default="true" />
		<setting id="quality.sd" type="bool" label="32046" default="true" />
		<setting id="filter.min_seeders" type="slider" label="32047" default="0" range="0,1,50" option="int" />
		<setting id="rd.keep_cloud" type="bool" label="32050" default="false" /><!-- Keep resolved torrents in RD cloud -->
		<setting id="rd.resolve_timeout" type="slider" label="32051" default="15" range="5,5,120" option="int" />
		<setting id="rd.uncached_grace" type="slider" label="32059" default="4" range="2,1,20" option="int" />
		<setting id="playback.show_provider" type="bool" label="32074" default="true" />
		<setting id="playback.label_provider" type="bool" label="32075" default="false" />
		<setting id="playback.autonext" type="bool" label="32052" default="true" />
		<setting id="playback.try.4k" type="slider" label="32070" default="5" range="0,1,20" option="int" subsetting="true" enable="eq(-1,true)" />
		<setting id="playback.try.1080p" type="slider" label="32071" default="5" range="0,1,20" option="int" subsetting="true" enable="eq(-2,true)" />
		<setting id="playback.try.720p" type="slider" label="32072" default="10" range="0,1,30" option="int" subsetting="true" enable="eq(-3,true)" />
		<setting id="playback.try.sd" type="slider" label="32073" default="0" range="0,1,20" option="int" subsetting="true" enable="eq(-4,true)" />
		<setting id="sources.packs" type="bool" label="32112" default="true" />
		<setting id="sources.plausible_size" type="bool" label="32113" default="true" />
		<setting id="sources.check_cache" type="bool" label="32054" default="true" />
		<setting id="sources.only_cached" type="bool" label="32055" default="false" subsetting="true" enable="eq(-1,true)" />
		<setting id="rd.cache_check_minutes" type="slider" label="32056" default="20" range="5,5,120" option="int" subsetting="true" enable="eq(-2,true)" />
		<setting id="playback.resume" type="enum" label="32110" values="Ask|Always|Never" default="0" />
		<setting id="playback.playnext" type="bool" label="32111" default="true" />
		<setting id="scrobble.enabled" type="bool" label="32048" default="true" /><!-- Scrobble to Trakt -->
		<setting id="scrobble.markwatched" type="bool" label="32049" default="true" subsetting="true" enable="eq(-1,true)" /><!-- Mark watched at end -->
		<setting id="scrobble.threshold.episode" type="slider" label="32057" default="80" range="10,5,100" option="int" subsetting="true" enable="eq(-1,true)" />
		<setting id="scrobble.threshold.movie" type="slider" label="32058" default="80" range="10,5,100" option="int" subsetting="true" enable="eq(-2,true)" />
	</category>

	<category label="32060"><!-- Lists -->
		<setting id="list.aired_only" type="bool" label="32061" default="true" /><!-- Only show aired episodes -->
		<setting id="list.sort" type="enum" label="32062" values="Last watched|Recently aired|Alphabetical" default="0" />
		<setting id="list.show_progress" type="bool" label="32114" default="true" />
		<setting id="list.inprogress_first" type="bool" label="32115" default="true" />
		<setting id="cache.hours" type="slider" label="32063" default="6" range="1,1,48" option="int" /><!-- Source cache (hours) -->
	</category>

	<category label="32100"><!-- Updates -->
		<setting id="updates.enabled" type="bool" label="32101" default="true" /><!-- Automatically check for updates -->
		<setting id="updates.interval" type="slider" label="32102" default="24" range="1,1,168" option="int" subsetting="true" enable="eq(-1,true)" /><!-- Check interval (hours) -->
		<setting id="updates.repo" type="text" label="32103" default="bmoorewiz/et" /><!-- Repository (owner/repo) -->
		<setting id="updates.branch" type="text" label="32104" default="claude/episode-tracker-kodi-app-qu73ll" /><!-- Branch -->
		<setting id="updates.token" type="text" label="32106" default="" option="hidden" /><!-- Access token (private repos only) -->
		<setting type="action" label="32105" action="RunPlugin(plugin://plugin.video.episodetracker/?action=check_updates)" option="close" /><!-- Check for updates now -->
	</category>

	<category label="32080"><!-- Tools -->
		<setting type="action" label="32081" action="RunPlugin(plugin://plugin.video.episodetracker/?action=clear_cache)" option="close" /><!-- Clear source cache -->
		<setting type="action" label="32082" action="RunPlugin(plugin://plugin.video.episodetracker/?action=coco_settings)" option="close" /><!-- Open CocoScrapers settings -->
		<setting id="debug.enabled" type="bool" label="32083" default="false" /><!-- Verbose logging -->
		<setting label="32084" type="lsep" /><!-- Diagnostics -->
		<setting type="action" label="32086" action="RunPlugin(plugin://plugin.video.episodetracker/?action=upload_logs)" option="close" />
	</category>
</settings>
